            <listEntry value="9">@Strings.MetricStress</listEntry>
            <listEntry value="10">@Strings.MetricSunrise</listEntry>
            <listEntry value="11">@Strings.MetricSunset</listEntry>
            <listEntry value="14">@Strings.MetricSunriseSunset</listEntry>
            <listEntry value="13">@Strings.MetricRespiration</listEntry>
            <listEntry value="15">@Strings.MetricWeeklyRun</listEntry>
            <listEntry value="16">@Strings.MetricMonthlyRun</listEntry>
            <listEntry value="17">@Strings.MetricNotifications</listEntry>
            <listEntry value="18">@Strings.MetricRecoveryTime</listEntry>
