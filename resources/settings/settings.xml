<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <setting propertyKey="@Properties.AccentColor" title="@Strings.AccentColorTitle">
        <settingConfig type="list">
            <listEntry value="0xB77CFF">@Strings.ColorPurple</listEntry>
            <listEntry value="0x55AAFF">@Strings.ColorBlue</listEntry>
            <listEntry value="0x00DDCC">@Strings.ColorCyan</listEntry>
            <listEntry value="0x55FF99">@Strings.ColorGreen</listEntry>
            <listEntry value="0xFFEE44">@Strings.ColorYellow</listEntry>
            <listEntry value="0xFFCC33">@Strings.ColorGold</listEntry>
            <listEntry value="0xFFAA55">@Strings.ColorOrange</listEntry>
            <listEntry value="0xFF5566">@Strings.ColorRed</listEntry>
            <listEntry value="0xFF77BB">@Strings.ColorPink</listEntry>
            <listEntry value="0xFFFFFF">@Strings.ColorWhite</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.ShowSeconds" title="@Strings.ShowSecondsTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowDate" title="@Strings.ShowDateTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowLunar" title="@Strings.ShowLunarTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowDividers" title="@Strings.ShowDividersTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowCompassRing" title="@Strings.ShowCompassRingTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.SleepModeEnabled" title="@Strings.SleepModeEnabledTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.TopLeftMetric" title="@Strings.TopLeftMetricTitle">
        <settingConfig type="list">
            <listEntry value="4">@Strings.MetricAltitude</listEntry>
            <listEntry value="0">@Strings.MetricNone</listEntry>
            <listEntry value="1">@Strings.MetricHeartRate</listEntry>
            <listEntry value="2">@Strings.MetricBattery</listEntry>
            <listEntry value="3">@Strings.MetricSteps</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.TopRightMetric" title="@Strings.TopRightMetricTitle">
        <settingConfig type="list">
            <listEntry value="2">@Strings.MetricBattery</listEntry>
            <listEntry value="0">@Strings.MetricNone</listEntry>
            <listEntry value="1">@Strings.MetricHeartRate</listEntry>
            <listEntry value="3">@Strings.MetricSteps</listEntry>
            <listEntry value="4">@Strings.MetricAltitude</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.BottomLeftMetric" title="@Strings.BottomLeftMetricTitle">
        <settingConfig type="list">
            <listEntry value="1">@Strings.MetricHeartRate</listEntry>
            <listEntry value="0">@Strings.MetricNone</listEntry>
            <listEntry value="2">@Strings.MetricBattery</listEntry>
            <listEntry value="3">@Strings.MetricSteps</listEntry>
            <listEntry value="4">@Strings.MetricAltitude</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.BottomRightMetric" title="@Strings.BottomRightMetricTitle">
        <settingConfig type="list">
            <listEntry value="3">@Strings.MetricSteps</listEntry>
            <listEntry value="0">@Strings.MetricNone</listEntry>
            <listEntry value="1">@Strings.MetricHeartRate</listEntry>
            <listEntry value="2">@Strings.MetricBattery</listEntry>
            <listEntry value="4">@Strings.MetricAltitude</listEntry>
        </settingConfig>
    </setting>

</settings>
