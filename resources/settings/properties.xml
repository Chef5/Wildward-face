<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <property id="AccentColor" type="number">0xB77CFF</property>
    <property id="CustomAccentColor" type="string"></property>
    <property id="SecondaryColor" type="number">0xFFFFFF</property>
    <property id="CustomSecondaryColor" type="string"></property>
    <property id="BackgroundColor" type="number">0x000000</property>
    <property id="CustomBackgroundColor" type="string"></property>
    <property id="ShowSeconds" type="boolean">true</property>
    <!-- 时间格式：0=跟随系统  1=12小时制  2=24小时制（仅改表盘显示，不改系统设置） -->
    <property id="TimeFormat" type="number">0</property>
    <!-- 时分分隔符：默认冒号；空字符串不显示；可为空格或其他字符 -->
    <property id="TimeSeparator" type="string">:</property>
    <!-- 中心时分字体：0=系统数字 1=冷凝粗体 2=冷凝 3=Bionic 4=Roboto -->
    <property id="TimeFontStyle" type="number">0</property>
    <!-- 中心时分字号：0=极小 1=小 2=中（默认） 3=大 4=特大 5=超大 6=极大 7=巨型 8=最大 -->
    <property id="TimeFontSize" type="number">2</property>
    <property id="ShowDate" type="boolean">true</property>
    <!-- 日期行字号（公历+农历/节气共用）：0=极小 1=小 2=中（默认） 3=大 4=特大 5=超大 -->
    <property id="DateFontSize" type="number">2</property>
    <property id="ShowLunar" type="boolean">true</property>
    <property id="ShowLunarFestivals" type="boolean">true</property>
    <property id="ShowDividers" type="boolean">true</property>
    <property id="ShowRingTicks" type="boolean">true</property>
    <property id="ShowSecondHand" type="boolean">true</property>
    <!-- 电量展示：0=百分制  1=续航时间 -->
    <property id="BatteryDisplay" type="number">0</property>

    <!-- 各位置指标 ID：0=不展示 1=心率 2=电量 3=步数 4=海拔 -->
    <property id="TopLeftMetric"     type="number">4</property>
    <property id="TopRightMetric"    type="number">2</property>
    <property id="BottomLeftMetric"  type="number">1</property>
    <property id="BottomRightMetric" type="number">3</property>

</properties>
